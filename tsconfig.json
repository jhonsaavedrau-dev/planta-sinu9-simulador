{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "types": ["node"],
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": { "@motor/*": ["../simulacion-procesos/app/src/*"] }
  },
  "include": ["src", "pruebas"]
}
